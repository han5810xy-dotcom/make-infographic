{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.make-infographic/knowledge-structure.schema.json",
  "title": "KnowledgeStructure",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "topic", "propositions", "relations", "topo", "backbone", "gaps"],
  "properties": {
    "id": { "type": "string", "pattern": "^s_[a-f0-9]{16}$" },
    "topic": { "type": "string", "minLength": 1, "maxLength": 60 },
    "topo": { "enum": ["chain", "tree", "matrix", "network", "cycle", "forest"] },
    "propositions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/proposition" }
    },
    "relations": {
      "type": "array",
      "items": { "$ref": "#/$defs/relation" }
    },
    "backbone": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": { "type": "string" }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["missing", "why"],
        "properties": {
          "missing": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    },
    "views": {
      "type": "array",
      "items": { "$ref": "#/$defs/view" }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["quote_id", "speaker", "turn_index", "verbatim"],
      "properties": {
        "quote_id": { "type": "string", "minLength": 1 },
        "speaker": { "enum": ["user", "assistant"] },
        "turn_index": { "type": "integer", "minimum": 0 },
        "verbatim": { "type": "boolean" }
      }
    },
    "proposition": {
      "type": "object",
      "required": ["id", "concept_id", "kind", "layer", "text", "evidence", "weight", "provenance"],
      "properties": {
        "id": { "type": "string", "pattern": "^p[0-9]+(_[a-f0-9]{8})?$" },
        "concept_id": { "type": "string", "pattern": "^c_[a-f0-9]{16}$" },
        "layer": { "enum": ["main", "branch", "example", "background"] },
        "probe_questions": { "type": "object", "additionalProperties": { "type": "string" } },
        "kind": { "enum": ["定义", "主张", "因果", "条件", "对比", "步骤", "例子", "例外", "数据"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 60 },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/evidence" } },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "provenance": { "enum": ["quote", "summary", "inferred"] }
      }
    },
    "relation": {
      "type": "object",
      "required": ["id", "from", "to", "kind", "evidence", "strength"],
      "properties": {
        "id": { "type": "string", "pattern": "^r[0-9]+(_[a-f0-9]{8})?$" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "kind": { "enum": ["因果", "递进", "对比", "条件", "转折", "包含", "支持", "反驳"] },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["quote_id", "verbatim"],
            "properties": {
              "quote_id": { "type": "string", "minLength": 1 },
              "verbatim": { "const": true }
            }
          }
        },
        "strength": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "view": {
      "type": "object",
      "required": ["id", "target", "graphic", "props"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "pattern": "^(backbone|branch:p[0-9]+(_[a-f0-9]{8})?)$" },
        "graphic": { "enum": ["flow", "tree", "matrix", "network", "turn-band"] },
        "props": { "type": "object" }
      }
    }
  }
}
